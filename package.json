{
  "name": "print-buddy",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev": "pnpm build && node scripts/dev.ts",
    "dev:ui": "node scripts/pdfjs-assets.ts && vite",
    "build": "node scripts/pdfjs-assets.ts && vite build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:server && pnpm test:ui",
    "test:server": "node --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@hono/node-server": "2.1.9",
    "exifr": "7.1.3",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "happy-dom": "21.0.4",
    "pdfjs-dist": "6.5.438",
    "solid-js": "2.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
